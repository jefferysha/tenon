{
  "name": "tenon",
  "private": true,
  "version": "0.1.10",
  "packageManager": "npm@11.16.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "docs-site"
  ],
  "scripts": {
    "generate:identity": "node tools/generate-product-identity.mjs",
    "check:identity": "node tools/check-product-identity.mjs && node --test tools/product-identity.node-test.mjs tools/check-product-identity.node-test.mjs tools/check-legacy-identity.node-test.mjs && node tools/check-legacy-identity.mjs",
    "build": "tsc -b packages/kernel packages/channel packages/tap packages/automation packages/cli packages/server && npm run build:web && npm run build:server && npm run bundle",
    "typecheck:web": "tsc --noEmit -p packages/dashboard-app",
    "build:server": "esbuild packages/server/src/main.ts --bundle --platform=node --format=esm --target=node22 --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --outfile=packages/server/dist/dashboard.mjs && chmod +x packages/server/dist/dashboard.mjs",
    "bundle": "esbuild packages/cli/src/main.ts --bundle --platform=node --format=esm --target=node22 --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --outfile=packages/cli/dist/tenon.mjs && chmod +x packages/cli/dist/tenon.mjs",
    "build:skill-provenance": "tsc -b packages/kernel packages/channel packages/tap packages/automation packages/cli && npm run bundle",
    "sync:skill-provenance": "npm run build:skill-provenance && node packages/cli/dist/tenon.mjs internal-skill-provenance sync --root \"$PWD\"",
    "skills:fetch": "npm run build:skill-provenance && node packages/cli/dist/tenon.mjs internal-skill-upstream fetch --root \"$PWD\"",
    "check:comments": "bash tools/check-comment-honesty.sh",
    "check:architecture": "node --test tools/kernel-runtime-import-graph.node-test.mjs && node tools/check-architecture.mjs",
    "check:dependency-tree": "npm ls --all",
    "check:dependencies": "npm audit --audit-level=high && npm run check:dependency-tree",
    "check:openspec": "node --test tools/check-openspec.node-test.mjs && node tools/check-openspec.mjs",
    "check:release-workflows": "node --test tools/check-release-workflows.node-test.mjs",
    "check:repository-hygiene": "node --test tools/check-repository-hygiene.node-test.mjs && node tools/check-repository-hygiene.mjs",
    "build:npx-package": "node tools/build-npx-package.mjs",
    "check:clean-checkout": "bash tools/check-clean-checkout.sh",
    "check:npx-package": "node --test tools/build-npx-package.node-test.mjs tools/install-bootstrap.node-test.mjs tools/clean-codex-install-acceptance.node-test.mjs",
    "test:clean-install": "node tools/clean-codex-install-acceptance.mjs --mode local",
    "test:clean-install:public": "node tools/clean-codex-install-acceptance.mjs --mode public",
    "build:legacy-bridge": "node tools/build-legacy-bridge.mjs",
    "check:legacy-bridge": "node --test tools/build-legacy-bridge.node-test.mjs && bash -n migration/legacy-channel/bridge.sh",
    "check:docs": "node --test tools/check-docs.node-test.mjs && node tools/check-docs.mjs",
    "check:design-scale": "node --test tools/check-design-scale.node-test.mjs && node tools/check-design-scale.mjs",
    "check:document-templates": "node tools/check-document-templates.mjs && npx vitest run packages/kernel/src/documents/document-template-renderer.test.ts",
    "check:instruction-templates": "node --test tools/check-instruction-templates.node-test.mjs && node tools/check-instruction-templates.mjs",
    "check:agents": "node --test tools/check-agents.node-test.mjs && node tools/check-agents.mjs",
    "docs:sync": "npm run sync -w @tenon/docs-site",
    "docs:check": "npm run check -w @tenon/docs-site",
    "docs:build": "npm run build -w @tenon/docs-site",
    "docs:smoke": "npm run smoke -w @tenon/docs-site",
    "test": "vitest run",
    "test:web": "vitest run --config packages/dashboard-app/vitest.config.ts",
    "test:hooks": "bash tools/test-hooks.sh",
    "test:migration-cas": "node --test tools/spec-migration-cas.node-test.mjs tools/reconcile-spec-application.node-test.mjs",
    "test:all": "npm run test && npm run test:web",
    "build:web": "npm run build -w @tenon/dashboard-app",
    "oracle": "bash tools/oracle/run.sh backend-full default-effects default-guard-errors frontend-quotegate pm-history",
    "generate:default-workflow": "node tools/generate-default-workflow.mjs",
    "generate:adapter-capabilities": "node tools/generate-adapter-capabilities.mjs",
    "check:adapter-capabilities-freshness": "npm run generate:adapter-capabilities && git diff --exit-code -- packages/kernel/src/catalog/adapter-capabilities.generated.ts",
    "generate:document-presentation": "node tools/generate-document-presentation.mjs",
    "check:default-skill-matrix": "node tools/check-default-skill-matrix.mjs",
    "check:default-workflow-freshness": "npm run generate:default-workflow && git diff --exit-code -- packages/kernel/src/workflow/default-workflow.generated.ts",
    "check:dashboard-dist-freshness": "node --test tools/check-dashboard-dist-freshness.node-test.mjs && node tools/check-dashboard-dist-freshness.mjs",
    "build:packages": "tsc -b packages/kernel packages/channel packages/tap packages/automation packages/cli packages/server",
    "pretest": "npm run build:packages"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.6.0",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "browserslist": "4.28.7",
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}

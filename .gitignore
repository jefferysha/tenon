node_modules/
dist/
# 分发例外：CLI bundle 随 Marketplace 插件入包。
# 三行缺一不可：dist/ 忽略了父目录后 git 不再下探，须先放行该目录、再重新忽略目录内全部内容、最后单独放行这一个 bundle。
# 其余 tsc 产物（main.js/commands/ 等）仍被忽略。改 cli src 后须 npm run build 重构并提交此 bundle，详见 docs/DIST-RELEASE.md。
!packages/cli/dist/
packages/cli/dist/*
!packages/cli/dist/tenon.mjs
# 分发面还包括 dashboard 的单文件 server bundle 与已构建 SPA。Marketplace 安装不带 node_modules，
# 因此不能只发布源码或让新用户再跑 npm/vite；完整插件必须直接包含这两组运行时产物。
!packages/server/dist/
packages/server/dist/*
!packages/server/dist/dashboard.mjs
!packages/dashboard-app/dist/
!packages/dashboard-app/dist/**
coverage/
.release/
*.tsbuildinfo
.DS_Store
# 运行时产物（项目包声明 / 门 marker / 历史）
.pipeline-project.yaml
.pipeline-pending-*
.breadcrumb
# afk run 结算日志（packages/automation/src/lifecycle/ports.ts::runWork 落盘，openspec/changes/
# <name>/ 内，同 .breadcrumb 同一类：单次运行的操作性产物，会被下一次 run 整体覆盖，不是要保留的
# 项目语义历史——不同于同目录内会被提交、构成审计轨迹的 .pipeline.yaml/.pipeline-history.jsonl）。
.sandcastle-run.log
.superpowers/

# git worktrees (isolated workstreams, per superpowers:using-git-worktrees)
.worktrees/

# Playwright 真机驱动脚本的临时落脚点（需要在仓内才能解析根 node_modules 的 playwright 包，
# 内容本身是一次性驱动脚本，不是要保留的项目资产）。
.playwright-tmp/

# 本机运行态与工具缓存：由 setup / hooks / 浏览器验收按需重建，不属于插件发布包。
.pipeline/
.playwright-mcp/
.sandcastle-build/
e2e-runs/
.agents/
.codex/
.impeccable/
.github/hooks/

# 可再生浏览器验收快照不入库；正式产品图只允许放在
# docs-site/public/images/dashboard-*.webp，并由 repository hygiene 门禁限制体积与链接。
/dashboard-progress-custom-spec.png
/dashboard-acceptance-*.png
/workbench-*.png
/workflow-governance-*.png
design-demos/shots/

# 正式文档站的确定性构建产物；源内容、manifest、主题与脚本入库。
docs-site/.generated/
docs-site/dist/
